{
	"name": "tjm/tobymackenzie.site"
	,"autoload": {
		"psr-4": {
			"": "src/",
			"PublicApp\\": "src"
		}
	}
	,"config": {
		"allow-plugins": {
			"composer/installers": true
		},
		"bin-dir": "bin"
	}
	,"extra": {
		"incenteev-parameters": [
			{"file": "config/public.local.yml"}
			,{"file": "config/symfony.local.yml"}
		]
	}
	,"conflict": {
		"symfony/symfony": "*"
	}
	,"require": {
		"php": ">=8.1"
		,"symfony/asset": "^6.4"
		,"symfony/framework-bundle": "^6.4"
		,"symfony/console": "^6.4"
		,"symfony/monolog-bundle": "^3.8"
		,"symfony/http-kernel": "^6.4"
		,"symfony/twig-bundle": "^6.4"
		,"incenteev/composer-parameter-handler": "^2.0"
		,"twig/twig": "^2.13|^3.11.2"

		,"tjm/files": "^0.0"
		,"tjm/wiki-blog": "^0.1"
		,"tjm/wiki-site": "^0.4"
		,"tjm/sy-site": "^0.11"
		,"tjm/sy-web": "^0.12"
		,"tjm/utils": "^0.0"
	}
	,"require-dev": {
		"chillerlan/php-qrcode": "^4.3"
		,"symfony/phpunit-bridge": "^6.4"
		,"symfony/process": "^6.4"
		,"symfony/browser-kit": "^6.4"
		,"symfony/stopwatch": "^6.4"
		,"symfony/var-dumper": "^6.4"
		,"symfony/web-profiler-bundle": "^6.4"
		,"tjm/static-web-tasks": "^0.2"
	}
	,"scripts": {
		"post": [
			"Incenteev\\ParameterHandler\\ScriptHandler::buildParameters"
			,"bin/public cache:clear --env prod"
			,"bin/public cache:clear"
			,"bin/public assets:install --symlink --relative dist/public"
		]
		,"post-install-cmd": ["@post"]
		,"post-update-cmd": ["@post"]
	}
	,"type": "project"
}
